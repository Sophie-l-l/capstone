# Dockerfile for CodeNet Import Job
# Runs entirely in GCP - no local download needed
FROM node:18-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    tar \
    gzip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY prisma ./prisma/

# Install dependencies
RUN npm ci --only=production

# Generate Prisma client
RUN npx prisma generate

# Copy import script
COPY prisma/cloud-import-codenet.ts ./

# Set environment for cloud execution
ENV NODE_ENV=production

# Run import
CMD ["npx", "ts-node", "cloud-import-codenet.ts"]
