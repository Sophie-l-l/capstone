# Production Environment Variables for Vercel
# Copy these to your Vercel project settings

# Backend API URL (Cloud Run)
NEXT_PUBLIC_API_URL=https://educode-backend-162585155042.us-central1.run.app

# AI Service URL (Cloud Run) - if needed directly from frontend
NEXT_PUBLIC_AI_SERVICE_URL=https://educode-ai-162585155042.us-central1.run.app

# Disable mock data in production
NEXT_PUBLIC_USE_MOCK_DATA=false
NEXT_PUBLIC_USE_MOCK_AUTH=false
NEXT_PUBLIC_USE_MOCK_PROBLEMS=false
NEXT_PUBLIC_USE_MOCK_ANALYTICS=false
