FROM python:3.13-slim

WORKDIR /app/apps/ai-service

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash build-essential curl \
    && rm -rf /var/lib/apt/lists/*

# Create venv in a path outside bind mounts (so host volumes don't shadow it)
RUN python -m venv /opt/venv

COPY apps/ai-service/requirements.txt /app/apps/ai-service/requirements.txt

RUN pip install --upgrade pip && pip install -r requirements.txt

COPY apps/ai-service /app/apps/ai-service

EXPOSE 8000

CMD ["bash", "-lc", "uvicorn main:app --host 0.0.0.0 --port 8000 --reload"]
