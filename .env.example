# Copy this file to .env and fill in values as needed.

# --- AI Service LLM (optional) ---
# OpenAI-compatible settings; leave empty to use rule-based classifier only.
OPENAI_API_KEY=
# If using Azure OpenAI or a proxy, set base URL; otherwise leave empty.
OPENAI_BASE_URL=
# Reasonable default; adjust to your available model
OPENAI_MODEL=gpt-4o-mini
# Confidence threshold below which the AI service will call the LLM
LLM_MIN_CONFIDENCE=0.75

# --- Backend ---
# AI service URL used by backend (compose already sets this)
AI_SERVICE_URL=http://ai-service:8000
# DATABASE_URL is set in compose for dev; override here if running locally
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/educode?schema=public
